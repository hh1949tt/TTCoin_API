# ---- 本地配置（绝不提交）----
# 从 config.example.php 复制而来，里面可能有你的域名、数据目录、
# 诊断密钥（TTCOIN_DIAG_TOKEN）、代理地址（TTCOIN_PROXY）、固定 IP（TTCOIN_RESOLVE）
config.php

# ---- 后台（admin.php）运行时数据 ----
# admin_settings.json 里是全部设置（含代理 / 诊断密钥），admin_pass.php 是密码 hash，
# admin_keys.json 是各设备的管理码，都不能进仓库。备份文件同理。
admin_settings.json
admin_settings.json.tmp
admin_keys.json
admin_keys.json.tmp
admin_pass.php
config.php.bak.*

# ---- 运行时数据：缓存与请求日志 ----
cache/*
!cache/.htaccess
logs/*
!logs/.htaccess
coin_cache.json
coin.log
coin.log.old
*.log

# ---- Cloudflare Worker 本地开发 ----
worker/.dev.vars
worker/.wrangler/
node_modules/

# ---- 编辑器 / 系统 ----
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.swp
